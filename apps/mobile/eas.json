{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "APP_VARIANT": "ordinaria" } },
    "production": { "env": { "APP_VARIANT": "ordinaria" } },
    "sensible-development": { "developmentClient": true, "distribution": "internal", "env": { "APP_VARIANT": "sensible" } },
    "sensible-apk": { "distribution": "internal", "android": { "buildType": "apk" }, "env": { "APP_VARIANT": "sensible" } },
    "sensible-production": { "env": { "APP_VARIANT": "sensible" } }
  }
}
